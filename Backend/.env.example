META_INSTAGRAM_VERIFY_TOKEN=

# Meta Integration (one centralized connection for CRM / ERP / AI Content)
META_APP_ID=
META_APP_SECRET=
# Must point at the API host and match the Meta app's Valid OAuth Redirect URIs
# Production: https://crmreadytechsolutions.in/api/meta/oauth/callback
META_REDIRECT_URI=
META_BUSINESS_PORTFOLIO_ID=
META_API_VERSION=v21.0
# Opt-in extra Facebook Login scopes (comma separated), e.g.
# pages_manage_metadata,pages_messaging — needed to subscribe the Page webhook
# that delivers Instagram/Messenger DMs. Reconnect Meta after changing.
META_EXTRA_SCOPES=

# Instagram Inbox — Instagram API with Instagram Login
# Meta App Dashboard → Instagram → API setup with Instagram login (Instagram app ID/secret,
# not the Facebook app's). Also verifies Instagram-Login webhook signatures.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional; defaults to <META_REDIRECT_URI origin>/api/meta/instagram/oauth/callback
INSTAGRAM_REDIRECT_URI=
# Optional; default workspace only — other workspaces never read it
INSTAGRAM_ACCESS_TOKEN=

# Twilio Voice (browser-based calling from the CRM Lead page)
TWILIO_ACCOUNT_SID=
# API Key pair used to mint short-lived Voice access tokens (never the auth token)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TwiML App whose Voice URL points at the API host: /api/voip/voice
TWILIO_TWIML_APP_SID=
# Verified Twilio number shown as the outbound caller ID (E.164, e.g. +919876543210)
TWILIO_CALLER_ID=
# Required to verify X-Twilio-Signature on the public /api/voip webhooks
TWILIO_AUTH_TOKEN=
# Public HTTPS base URL of THIS api host; used to build the status callback
# Dev: an ngrok URL. Production: https://crmreadytechsolutions.in
TWILIO_PUBLIC_URL=

# Email Integration (per-workspace Gmail / Microsoft 365 OAuth)
# Redirect URIs must point at the API host and be registered with the provider, e.g.
#   https://crmreadytechsolutions.in/api/email/oauth/google/callback
#   https://crmreadytechsolutions.in/api/email/oauth/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=
MICROSOFT_TENANT_ID=common
# Zoho Mail (api-console.zoho.com → Server-based app; enable Multi-DC)
# Redirect URI: https://<api-host>/api/email/oauth/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_OAUTH_REDIRECT_URI=
# Recommended: dedicated key for encrypting stored email tokens (else derived from JWT_SECRET)
EMAIL_TOKEN_ENCRYPTION_KEY=

# Shopify Integration (one ReadyTech Shopify app; each workspace connects its own store)
# Partner Dashboard → App setup: set the allowed redirection URL to SHOPIFY_OAUTH_REDIRECT_URI,
# the App URL to <CLIENT_URL>/shopify/return (non-embedded app), and the compliance webhooks
# (customers/data_request, customers/redact, shop/redact) to SHOPIFY_WEBHOOK_URL.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Exactly what the implementation uses (keep identical to the app's scopes in the Partner Dashboard):
#   read_products   products/* webhooks + variant scan (SKU mapping)
#   read_orders     orders/* + refunds/create webhooks (order import)
#   read_inventory, write_inventory   inventory_levels/update + inventorySetQuantities (stock push)
#   read_locations  location list for warehouse ↔ location mapping
#   read_fulfillments   fulfillments/* webhooks
# Customer details arrive inside order payloads (Protected Customer Data approval), not via read_customers.
SHOPIFY_SCOPES=read_products,read_orders,read_inventory,write_inventory,read_locations,read_fulfillments
# Pinned GraphQL Admin API version (a currently supported stable release, e.g. 2026-07)
SHOPIFY_API_VERSION=
# e.g. https://crmreadytechsolutions.in/api/shopify/oauth/callback
SHOPIFY_OAUTH_REDIRECT_URI=
# e.g. https://crmreadytechsolutions.in/api/shopify/webhooks
SHOPIFY_WEBHOOK_URL=
# Required, dedicated: 32 random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
SHOPIFY_TOKEN_ENCRYPTION_KEY=
# Required to connect a store: dedicated OAuth state signing secret (>= 32 chars, must differ from JWT_SECRET),
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Without it existing connections, webhooks and sync keep working; only Connect is unavailable.
SHOPIFY_STATE_SECRET=
# Optional: the app's Shopify install link (Dev Dashboard → Distribution), e.g. https://admin.shopify.com/oauth/install?client_id=…
# When set, "Connect Shopify" is one button (merchant signs in to Shopify and picks the store); otherwise the store address is asked.
SHOPIFY_INSTALL_URL=
# Expiring offline tokens with refresh (default on); set false to request non-expiring tokens
SHOPIFY_EXPIRING_OFFLINE_TOKENS=
# Set true to stop this instance processing the Shopify webhook inbox (events are still recorded)
SHOPIFY_WORKER_DISABLED=
