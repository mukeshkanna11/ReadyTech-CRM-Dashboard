META_INSTAGRAM_VERIFY_TOKEN=

# Meta Integration (one centralized connection for CRM / ERP / AI Content)
META_APP_ID=
META_APP_SECRET=
# Must point at the API host and match the Meta app's Valid OAuth Redirect URIs
# Production: https://crmreadytechsolutions.in/api/meta/oauth/callback
META_REDIRECT_URI=
META_BUSINESS_PORTFOLIO_ID=
META_API_VERSION=v21.0

# Twilio Voice (browser-based calling from the CRM Lead page)
TWILIO_ACCOUNT_SID=
# API Key pair used to mint short-lived Voice access tokens (never the auth token)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TwiML App whose Voice URL points at the API host: /api/voip/voice
TWILIO_TWIML_APP_SID=
# Verified Twilio number shown as the outbound caller ID (E.164, e.g. +919876543210)
TWILIO_CALLER_ID=
# Required to verify X-Twilio-Signature on the public /api/voip webhooks
TWILIO_AUTH_TOKEN=
# Public HTTPS base URL of THIS api host; used to build the status callback
# Dev: an ngrok URL. Production: https://crmreadytechsolutions.in
TWILIO_PUBLIC_URL=

# Email Integration (per-workspace Gmail / Microsoft 365 OAuth)
# Redirect URIs must point at the API host and be registered with the provider, e.g.
#   https://crmreadytechsolutions.in/api/email/oauth/google/callback
#   https://crmreadytechsolutions.in/api/email/oauth/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=
MICROSOFT_TENANT_ID=common
# Recommended: dedicated key for encrypting stored email tokens (else derived from JWT_SECRET)
EMAIL_TOKEN_ENCRYPTION_KEY=

# Shopify Integration (one ReadyTech Shopify app; each workspace connects its own store)
# Partner Dashboard → App setup: set the allowed redirection URL to SHOPIFY_OAUTH_REDIRECT_URI,
# the App URL to <CLIENT_URL>/integrations/shopify, and the compliance webhooks
# (customers/data_request, customers/redact, shop/redact) to SHOPIFY_WEBHOOK_URL.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Requested up-front so later sync phases need no re-authorization
SHOPIFY_SCOPES=read_products,read_orders,read_customers,read_locations,read_inventory,write_inventory,read_fulfillments
# Pinned GraphQL Admin API version (a currently supported stable release, e.g. 2026-07)
SHOPIFY_API_VERSION=
# e.g. https://crmreadytechsolutions.in/api/shopify/oauth/callback
SHOPIFY_OAUTH_REDIRECT_URI=
# e.g. https://crmreadytechsolutions.in/api/shopify/webhooks
SHOPIFY_WEBHOOK_URL=
# Required, dedicated: 32 random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
SHOPIFY_TOKEN_ENCRYPTION_KEY=
# Expiring offline tokens with refresh (default on); set false to request non-expiring tokens
SHOPIFY_EXPIRING_OFFLINE_TOKENS=
# Set true to stop this instance processing the Shopify webhook inbox (events are still recorded)
SHOPIFY_WORKER_DISABLED=
